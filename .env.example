# Safe local defaults. Copy to an untracked .env file only when needed.
APP_ENV=development
PAID_SPEND_LIMIT_CENTS=0
MODEL_API_ENABLED=false
EMAIL_DELIVERY_ENABLED=false

# Optional credentials never enable an adapter by themselves.
# MODEL_API_KEY=
# EMAIL_DELIVERY_TOKEN=

# Required with a positive spend limit or an enabled paid-capable adapter.
# This is a nonsecret approval reference, not a credential.
# OWNER_SPEND_AUTHORIZATION_ID=
