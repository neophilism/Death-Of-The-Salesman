{
  "openapi": "3.1.1",
  "info": {
    "title": "Death Of The Salesman domain contracts",
    "version": "2026-10-01",
    "description": "Versioned shared data contracts. Authorization, spend and dispatch are separate server-side gates."
  },
  "paths": {
    "/api/v1/projects": {
      "get": {
        "summary": "List projects for the authenticated organization",
        "responses": {
          "200": {
            "description": "Tenant project list"
          }
        }
      },
      "post": {
        "summary": "Create a project as an authorized owner",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/catalogWrite"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          }
        }
      }
    },
    "/api/v1/projects/{projectId}": {
      "get": {
        "summary": "Reload one tenant project",
        "responses": {
          "200": {
            "description": "Project"
          }
        }
      },
      "patch": {
        "summary": "Edit one exact project version",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/catalogWrite"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated"
          },
          "409": {
            "description": "Missing, archived, or stale"
          }
        }
      }
    },
